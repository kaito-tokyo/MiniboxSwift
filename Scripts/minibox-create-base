# file: Scripts/minibox-create-base
# author: Kaito Udagawa <umireon@kaito.tokyo>
# version: 0.1.0
# date: 2026-04-30

set -eu

MINIBOX_VERSION=0.1.0
: "${MINIBOX_DATA_DIR:=$HOME/Library/Application Support/tokyo.kaito.MiniboxSwift.minibox}"

usage() {
	printf 'minibox-create-base: Creates a new base image from resources.\n'
	printf 'Usage: minibox-create-base <macos|...> [args...]\n'
	printf 'Available subcommands:\n'
	printf '  macos  Creates a macOS base image from IPSW.\n'
}

if [ "$#" -eq 0 ]; then
	usage >&2
	exit 64
fi

case "$1" in
--version)
	printf 'minibox-create-base %s\n' "$MINIBOX_VERSION"
	exit 0
	;;
--help)
	usage
	exit 0
	;;
esac

subcommand="minibox-create-base-$1"
shift

[ -n "${MINIBOX_PATH:-}" ] && PATH="$MINIBOX_PATH:$PATH"
export MINIBOX_DATA_DIR

if ! command -v "$subcommand" >/dev/null 2>&1; then
	printf 'ERROR: Unsupported subcommand %s\n' "$subcommand" >&2
	usage >&2
	exit 64
fi

exec "$subcommand" "$@"
