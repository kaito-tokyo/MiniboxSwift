# file: Scripts/minibox-ls
# author: Kaito Udagawa <umireon@kaito.tokyo>
# version: 0.1.0
# date: 2026-05-04

setopt errexit nounset nullglob pipefail warn_create_global

MINIBOX_VERSION=0.1.0
: "${MINIBOX_DATA_DIR:=$HOME/Library/Application Support/tokyo.kaito.MiniboxSwift.minibox}"

usage() {
	printf 'minibox-ls: Lists the images available in the Minibox data directory.\n'
	printf 'Usage: minibox-ls [all]\n'
	printf '  all  Lists all the images in human-readable format.\n'
}

minibox-ls-all() {
	local bundlePath baseImageName
	for bundlePath in "$MINIBOX_DATA_DIR/BaseImages"/*.miniboxvm(N/); do
		baseImageName="${bundlePath:t:r}"
		printf 'BaseImage=%s\n' "$baseImageName"
		printf '  # To run this miniboxvm bundle with a graphical screen:\n'
		printf '  minibox view --bundle-path=%q\n' "$bundlePath"
		printf '\n'
		printf '  # To prepare this base image for macOS:\n'
		printf '  minibox prepare --base-image-name=%q --variant=macos\n' "$baseImageName"
		printf '\n'
	done
}

if [ "$#" -eq 0 ]; then
	subcommand="minibox-ls-${1:-all}"
else
	case "$1" in
	--version)
		printf 'minibox-ls %s\n' "$MINIBOX_VERSION"
		exit 0
		;;
	--help)
		usage
		exit 0
		;;
	*)
		subcommand="minibox-ls-$1"
		shift
		;;
	esac
fi

[ -n "${MINIBOX_PATH:-}" ] && PATH="$MINIBOX_PATH:$PATH"
export MINIBOX_DATA_DIR

if (($+functions[$subcommand])); then
	"$subcommand" "$@"
elif whence "$subcommand" >/dev/null 2>&1; then
	exec "$subcommand" "$@"
else
	printf 'ERROR: Unsupported subcommand %s\n' "$subcommand" >&2
	usage >&2
	exit 64
fi
